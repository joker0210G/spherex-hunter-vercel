# 🛰️ SPHEREx Hunter - Environment Configuration
# NASA Space Apps Challenge 2026

# Server Host & Port
API_HOST=0.0.0.0
API_PORT=8000

# Cache Directory
CACHE_DIR=backend/cache

# NASA IRSA TAP Service URL
IRSA_TAP_URL=https://irsa.ipac.caltech.edu/TAP

# Offline Demo Mode (serve from pre-bundled cache without network latency)
DEMO_MODE=true

# Log Level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

