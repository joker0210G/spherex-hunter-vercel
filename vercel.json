{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api/index.py" },
    { "source": "/assets/:path*", "destination": "/frontend/assets/:path*" },
    { "source": "/vendor/:path*", "destination": "/frontend/vendor/:path*" },
    { "source": "/src/:path*", "destination": "/frontend/src/:path*" },
    { "source": "/audio/:path*", "destination": "/frontend/audio/:path*" },
    { "source": "/favicon.svg", "destination": "/frontend/favicon.svg" },
    { "source": "/app", "destination": "/frontend/index.html" },
    { "source": "/app/:path*", "destination": "/frontend/:path*" },
    { "source": "/", "destination": "/frontend/index.html" }
  ]
}
